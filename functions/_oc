#compdef oc

local -a profiles
local dir
for dir in "${HOME}/.config/opencode/profiles"/*/; do
    [[ -f "${dir}opencode.jsonc" ]] && profiles+=("${dir:t}")
done

_arguments -C \
    '(-p --profile)'{-p,--profile}'[Opencode profile]:profile:compadd -a profiles' \
    '(-c --copy)'{-c,--copy}'[Copy a profile to a new profile]' \
    '(-f --force)'{-f,--force}'[Overwrite existing destination profile]' \
    '(-d --delete)'{-d,--delete}'[Delete a profile]' \
    '(-r --restart)'{-r,--restart}'[Restart the background server for this profile]' \
    '(-s --stop)'{-s,--stop}'[Stop the background server for this profile]' \
    '--adopt[Re-verify and adopt the recorded live server for this profile]' \
    '--reset[Discard wrapper metadata for this profile without stopping anything]' \
    '*:: :->args'

if [[ $state == args ]]; then
    if [[ -n ${opt_args[(I)-c]} || -n ${opt_args[(I)--copy]} ]]; then
        case $CURRENT in
            1) compadd -a profiles ;;
            2) _message "Destination profile name" ;;
        esac
    elif [[ -n ${opt_args[(I)-d]} || -n ${opt_args[(I)--delete]} ]]; then
        compadd -a profiles
    else
        words=(opencode "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%%:*}:opencode:"
        _opencode
    fi
fi